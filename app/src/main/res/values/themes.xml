<resources>
    <style name="Theme.Reader" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1A237E</item>
        <item name="colorPrimaryDark">#000051</item>
        <item name="colorAccent">#FFEB3B</item>
        <item name="android:windowBackground">#F5F5F5</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A237E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Reader</item>
    </style>
</resources>
