    <string name="acc_title">TalkBack Optimization</string>
    <string name="acc_intro">Deeply customized experiences for screen readers:</string>
    <string name="acc_item_1">Semantic Labels: Precise descriptions for all icons and buttons.</string>
    <string name="acc_item_2">Focus Flow: Ensuring focus follows the document logical order.</string>
    <string name="acc_item_3">High Contrast: Support black background with yellow text.</string>
    <string name="acc_item_4">Real-time Feedback: Progress and status broadcasted via TTS.</string>

    <string name="feedback_intro">Thank you for using Smart Reader! If you have any questions or suggestions, please contact us:</string>
    <string name="feedback_email">Email: support@danmo-reader.com</string>
    <string name="feedback_wechat">WeChat: ReaderHelper</string>
    <string name="feedback_footer">Your feedback helps us do better.</string>

    <string name="privacy_intro">We value your privacy highly:</string>
    <string name="privacy_item_1">1. Local Processing: All parsing and OCR are done locally on your device.</string>
    <string name="privacy_item_2">2. Minimum Permissions: Only request Camera and Storage as necessary.</string>
    <string name="privacy_item_3">3. History Management: Reading history is only stored in local DataStore.</string>
    <string name="privacy_item_4">4. No Third-party Sharing: We never share your data with anyone.</string>
    <string name="privacy_confirm">Agree and Accept</string>

    <string name="about_main_title">About Smart Reader</string>
    <string name="about_desc">Smart Reader is an all-in-one document assistant for visually impaired users. Supports Word, Excel, PPT, PDF and OCR to eliminate reading barriers.</string>
    <string name="about_copyright">© 2024 Smart Reader Team</string>

